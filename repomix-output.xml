<file path="prisma/schema.prisma">
datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Project {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  repoPath    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]

  @@index([isActive])
}

model Task {
  id               String    @id @default(uuid())
  title            String
  description      String?
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent            String
  state            String    @default("BACKLOG")
  result           String?
  requiresApproval Boolean   @default(false)
  createdAt        DateTime  @default(now())
  finishedAt       DateTime?
  updatedAt        DateTime  @updatedAt
  approvals        Approval[]

  @@index([projectId])
  @@index([state])
  @@index([agent])
}

model ActivityLog {
  id        String   @id @default(uuid())
  taskId    String?
  agent     String
  action    String
  details   String?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([agent])
}

model Approval {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actionType   String
  description  String
  status       String   @default("PENDING")
  requestedAt  DateTime @default(now())
  resolvedAt   DateTime?
  resolvedNote String?

  @@index([status])
  @@index([taskId])
}
